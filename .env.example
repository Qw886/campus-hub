# Copy this file to .env on the server and replace every value before starting.
# Generate passwords with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
MYSQL_APP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD

# Generate with: openssl rand -base64 48
# Must be a valid Base64 secret; never reuse the example or commit your real value.
CAMPUS_HUB_JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET
